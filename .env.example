# Supabase project (Settings → API). The publishable/anon key is safe for the browser.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# ---------------------------------------------------------------------------
# Server only — NEVER prefix these with NEXT_PUBLIC_ and never commit real values.
# ---------------------------------------------------------------------------

# Creating users, background jobs (reminders, email outbox), OTP and security logs.
SUPABASE_SERVICE_ROLE_KEY=

# Master key for encrypting SMTP/IMAP passwords and hashing OTP codes / device ids.
# 32 random bytes, base64. Generate once and keep it safe (losing it means re-entering
# the email passwords):  node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
APP_ENCRYPTION_KEY=

# Public URL of the application (used in email links and the security center HTTPS check).
APP_URL=https://clinic.example.com

# Optional: shared secret for GET /api/cron/reminders (Authorization: Bearer <CRON_SECRET>).
# The app server already runs the jobs every minute; use this only for an external scheduler.
CRON_SECRET=

# Optional: set to "false" to disable the in-process job scheduler (e.g. on extra instances).
# JOBS_ENABLED=true

# Optional PDF engine settings. By default a local Chrome/Edge is used when present,
# otherwise the bundled @sparticuz/chromium (Linux x64).
# CHROME_PATH=/usr/bin/chromium
# INTERNAL_APP_URL=http://127.0.0.1:3000
